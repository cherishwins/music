# White Tiger (creative-hub) environment.
# Every name the app reads, grouped. Names only: fill values in .env, never here.
# NEXT_PUBLIC_* are inlined at BUILD time (Docker build args): changing one
# means rebuilding. Everything else is runtime env.
# Set by the platform, not here: NODE_ENV, NEXT_OUTPUT, VERCEL_GIT_COMMIT_SHA.

# ============================================
# REQUIRED
# ============================================

# Public URL of this deployment (OG images, settlement fulfilment calls)
NEXT_PUBLIC_APP_URL=

# Turso (libSQL): users, credits, tracks, transactions
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Telegram bot + Stars payments. The webhook secret is the secret_token passed
# to setWebhook; the webhook routes refuse every update (503) until it is set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# x402 USDC. X402_ENABLED must be the literal "true", or paid routes are free.
# X402_PAYMENT_ADDRESS is the EVM (Base) address that receives USDC; x402
# payments are refused while it is unset.
X402_ENABLED=
X402_PAYMENT_ADDRESS=

# AI generation
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# OPTIONAL
# ============================================

# Operator-only routes (/api/admin/costs, /api/voice/clone, /api/intel/blitz)
# take "Authorization: Bearer <ADMIN_TOKEN>" and return 503 while it is unset.
ADMIN_TOKEN=
# Bearer token for /api/cron/keep-alive
CRON_SECRET=

# Payment webhooks and settlement (each webhook returns 503 until its secret is set)
X402_FACILITATOR_URL=
X402_WEBHOOK_SECRET=
COINBASE_WEBHOOK_SECRET=
SETTLEMENT_SECRET=
TIGER_PAYMENTS_ADDRESS=
TIGER_PAYMENTS_ADDRESS_TESTNET=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# TON
NEXT_PUBLIC_TON_WALLET_ADDRESS=
NEXT_PUBLIC_TON_PAYMENT_ADDRESS=
NEXT_PUBLIC_TON_MANIFEST_URL=
TON_PAYMENT_ADDRESS=
TONAPI_KEY=

# Coinbase Onramp
NEXT_PUBLIC_COINBASE_PROJECT_ID=

# n8n webhooks
NEXT_PUBLIC_N8N_CONTENT_CREATED_WEBHOOK=
NEXT_PUBLIC_N8N_SOCIAL_DISTRIBUTE_WEBHOOK=
NEXT_PUBLIC_N8N_USER_SIGNUP_WEBHOOK=
NEXT_PUBLIC_N8N_PAYMENT_COMPLETE_WEBHOOK=
NEXT_PUBLIC_N8N_ANALYTICS_WEBHOOK=

# Vectors and file storage
QDRANT_URL=
QDRANT_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Other AI providers
REPLICATE_API_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
FAL_KEY=
SUNO_API_KEY=
AI_GATEWAY_API_KEY=

# Token intelligence
DYOR_API_KEY=
SHODAN_API_KEY=

# Social distribution (/api/intel/blitz)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
LINKEDIN_ACCESS_TOKEN=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
PINTEREST_ACCESS_TOKEN=
MEDIUM_INTEGRATION_TOKEN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DISCORD_WEBHOOK_URLS=
TELEGRAM_DISTRIBUTION_CHANNELS=
